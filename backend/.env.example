# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — local PostgreSQL (default)
POSTGRES_DB=iamkomik
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Database — Supabase / managed Postgres.
# Set DATABASE_URL to override the POSTGRES_* values above. Use the Supabase
# connection pooler (port 6543) for the serverless Vercel deployment.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DB_CONN_MAX_AGE=0
# DB_SSL_REQUIRE=true
# DB_DISABLE_SERVER_SIDE_CURSORS=true

# Upstream content API
SANKAA_API_BASE=https://www.sankavollerei.web.id
SANKAA_PROXY_BASE=

# Google OAuth Web Client ID (dipakai untuk memverifikasi ID token)
GOOGLE_CLIENT_ID=

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5187,http://127.0.0.1:5187
# CORS_ALLOWED_ORIGIN_REGEXES=^https://iamkomik(-[a-z0-9-]+)?\.vercel\.app$
# CSRF_TRUSTED_ORIGINS=http://localhost:5187,http://127.0.0.1:5187
