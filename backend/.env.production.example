# Production values for the Vercel backend project.
# Set these in Vercel → Project → Settings → Environment Variables.
# Do not commit a real .env.production file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=True

# Supabase Postgres — use the connection pooler for serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=true
DB_DISABLE_SERVER_SIDE_CURSORS=true

SANKAA_API_BASE=https://www.sankavollerei.web.id
SANKAA_PROXY_BASE=

# Replace with the actual Vercel frontend domain after the first deploy.
CORS_ALLOWED_ORIGINS=https://iamkomik.vercel.app
CORS_ALLOWED_ORIGIN_REGEXES=^https://iamkomik(-[a-z0-9-]+)?\.vercel\.app$
CSRF_TRUSTED_ORIGINS=https://iamkomik.vercel.app,https://iamkomik-api.vercel.app
